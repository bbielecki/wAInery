{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wainery.local/contracts/tools/agent-advice-request.v1.schema.json",
  "title": "AgentAdviceRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "workspaceId",
    "purpose",
    "role",
    "subject",
    "asOf",
    "inputRevision",
    "sourceVersions",
    "evidenceRefs",
    "facts",
    "allowedTools",
    "outputSchemaId",
    "maxInputTokens",
    "maxOutputTokens",
    "maxCostUsd",
    "timeoutMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "enum": [
        "PRIVATE_ADVICE",
        "EVALUATION"
      ]
    },
    "role": {
      "enum": [
        "VINEYARD_ADVISOR",
        "WINEMAKING_ADVISOR"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "kind",
        "id"
      ],
      "properties": {
        "module": {
          "enum": [
            "Vineyard",
            "Winery",
            "Observations",
            "Weather",
            "Knowledge",
            "Connectivity",
            "Decisions"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "version"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "PRIVATE_COPYRIGHT",
              "PRIVATE_DERIVED",
              "PRIVATE_OPERATIONAL",
              "PUBLIC_LICENSED",
              "PUBLIC_REFERENCE"
            ]
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "sourceRef"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "PRIVATE_OPERATIONAL",
              "PUBLIC_REFERENCE",
              "PUBLIC_LICENSED",
              "PRIVATE_DERIVED",
              "PRIVATE_COPYRIGHT"
            ]
          }
        }
      }
    },
    "allowedTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "SEARCH_EVIDENCE",
          "GET_OBSERVATIONS",
          "GET_WEATHER",
          "GET_DOMAIN_CONTEXT"
        ]
      }
    },
    "outputSchemaId": {
      "const": "AgentAdviceResultV1"
    },
    "maxInputTokens": {
      "type": "integer",
      "minimum": 1
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 1
    },
    "maxCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000
    }
  }
}
