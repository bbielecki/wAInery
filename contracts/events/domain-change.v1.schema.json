{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wainery.local/contracts/events/domain-change.v1.schema.json",
  "title": "DomainChangeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "workspaceId",
    "aggregateId",
    "aggregateVersion",
    "subject",
    "effectiveAt",
    "occurredAt",
    "recordedAt",
    "correlationId",
    "changedFields",
    "dataRef"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "VineyardProfileChanged",
        "PhenologicalStageConfirmed",
        "VineyardActivityRecorded",
        "WineBatchStateChanged",
        "WineryOperationRecorded",
        "VesselOccupancyChanged",
        "ObservationRecorded",
        "ObservationCorrected",
        "WeatherForecastPublished",
        "KnowledgeIndexPublished",
        "DocumentRightsChanged",
        "PredictionInvalidated",
        "PredictionUpdated",
        "DecisionPlanPublished",
        "DecisionPlanSuperseded"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "kind",
        "id"
      ],
      "properties": {
        "module": {
          "enum": [
            "Vineyard",
            "Winery",
            "Observations",
            "Weather",
            "Knowledge",
            "Connectivity",
            "Decisions"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "changedFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dataRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "version"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string"
        },
        "classification": {
          "enum": [
            "PRIVATE_COPYRIGHT",
            "PRIVATE_DERIVED",
            "PRIVATE_OPERATIONAL",
            "PUBLIC_LICENSED",
            "PUBLIC_REFERENCE"
          ]
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
